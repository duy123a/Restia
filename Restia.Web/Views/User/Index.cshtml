@model PaginationViewModel<UserViewModel>
@using Microsoft.Extensions.Localization
@using Restia.Common.Localization.Resources
@using Restia.Common.Permission.Constants
@using Restia.Common.Permission.Services.Interfaces
@using X.PagedList.Mvc.Core
@using Microsoft.AspNetCore.WebUtilities;
@inject IStringLocalizer<SharedResources> Localizer
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = Localizer["User_Title"];
    var canModify = await PermissionService.HasPermissionAsync(User, PermissionConstants.User.Available);
    var canManagePermission = await PermissionService.HasPermissionAsync(User, PermissionConstants.Permission.Default);
}

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">@Localizer["User_Title"]</h1>
            <p class="page-subtitle">@Localizer["User_Subtitle"]</p>
        </div>
        @if (canModify)
        {
            <a asp-action="Create" class="btn app-btn app-btn-primary">
                <i class="bi bi-plus-lg me-1"></i>@Localizer["Button_Create"]
            </a>
        }
    </div>

    <partial name="_TempDataAlerts" />

    <div class="app-card page-card">
        <partial name="_PaginationToolbar" model="new PaginationViewModel<object> {
            SearchTerm = Model.SearchTerm,
            OrderBy = Model.OrderBy,
            PageSize = Model.PageSize,
            SearchPlaceholderKey = Model.SearchPlaceholderKey
        }" />

        <div class="table-responsive">
            <table class="table data-table data-table--users mb-0">
                <thead>
                    <tr>
                        <th class="col-username">
                            <a asp-action="Index"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-orderBy="@(Model.OrderBy == AppConstants.UserNameDesc ? AppConstants.UserNameAsc : AppConstants.UserNameDesc)"
                               asp-route-pageSize="@Model.PageSize"
                               class="sort-header-link">
                                <span>@Localizer["User_UserName"]</span>
                                <span class="sort-icons">
                                    <i class="bi bi-caret-up-fill sort-icon @(Model.OrderBy == AppConstants.UserNameAsc ? "active" : "")"></i>
                                    <i class="bi bi-caret-down-fill sort-icon @(Model.OrderBy == AppConstants.UserNameDesc ? "active" : "")"></i>
                                </span>
                            </a>
                        </th>
                        <th class="col-email">
                            <a asp-action="Index"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-orderBy="@(Model.OrderBy == AppConstants.EmailDesc ? AppConstants.EmailAsc : AppConstants.EmailDesc)"
                               asp-route-pageSize="@Model.PageSize"
                               class="sort-header-link">
                                <span>@Localizer["User_Email"]</span>
                                <span class="sort-icons">
                                    <i class="bi bi-caret-up-fill sort-icon @(Model.OrderBy == AppConstants.EmailAsc ? "active" : "")"></i>
                                    <i class="bi bi-caret-down-fill sort-icon @(Model.OrderBy == AppConstants.EmailDesc ? "active" : "")"></i>
                                </span>
                            </a>
                        </th>
                        <th class="col-roles">@Localizer["User_Roles"]</th>
                        <th class="col-actions text-end">@Localizer["User_Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">
                                <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                @Localizer["User_NoRecords"]
                            </td>
                        </tr>
                    }
                    @foreach (var user in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2 user-cell-content">
                                    @{
                                        var initial = !string.IsNullOrWhiteSpace(user.UserName)
                                            ? user.UserName[0]
                                            : !string.IsNullOrWhiteSpace(user.Email)
                                                ? user.Email[0]
                                                : '?';
                                    }
                                    <span class="admin-avatar">@initial</span>
                                    <div class="user-info-text">
                                        <div class="fw-semibold user-display-name" title="@user.UserName">@user.UserName</div>
                                        @if (user.IsLockedOut)
                                        {
                                            <span class="badge app-badge-danger">@Localizer["User_LockedOut"]</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="user-email-text" title="@user.Email">@user.Email</div>
                            </td>
                            <td>
                                @if (user.Roles.Count > 0)
                                {
                                    <div class="d-flex align-items-center gap-1 flex-nowrap user-cell-content">
                                        <span class="badge app-badge text-truncate" title="@user.Roles[0]">@user.Roles[0]</span>
                                        @if (user.Roles.Count > 1)
                                        {
                                            <span class="badge app-badge-more"
                                                  title="@string.Join(", ", user.Roles.Skip(1))">
                                                +@(user.Roles.Count - 1)
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td class="text-end">
                                <partial name="_TableActions"
                                     model="@(new TableActionsViewModel
                                     {
                                         CanModify = canModify,
                                         EditUrl = Url.Action("Edit", new { id = user.Id }),
                                         DeleteAction = "Delete",
                                         DeleteId = user.Id,
                                         PermissionUrl = canManagePermission
                                            ? QueryHelpers.AddQueryString(
                                                Url.Action("Index", "Permission")!,
                                                new Dictionary<string, string?>
                                                {
                                                    ["type"] = "User",
                                                    ["id"] = user.Id
                                                })
                                            : null
                                     })" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Items.PageCount > 1)
        {
            <div class="data-table-pagination">
                @Html.PagedListPager(
                    Model.Items,
                    page => Url.Action("Index", new { searchTerm = Model.SearchTerm, orderBy = Model.OrderBy, page, pageSize = Model.PageSize })!,
                    new PagedListRenderOptions
                    {
                        LiElementClasses = ["pagination-li-element"],
                        PageClasses = ["pagination-page"],
                        UlElementClasses = ["pagination-ul-element", "mb-0"]
                    })
            </div>
        }
    </div>
</div>
